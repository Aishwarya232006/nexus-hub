# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it's already in .gitignore.

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nexushub

# Secret used to sign JWTs. Use a long, random string in production
# (e.g. generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string

# Gmail account used to send OTP emails via Nodemailer.
# GOOGLE_PASSWORD should be a Gmail "App Password", not your real password:
# https://support.google.com/accounts/answer/185833
GOOGLE_EMAIL=your_email@gmail.com
GOOGLE_PASSWORD=your_gmail_app_password

# Server config
PORT=5000
NODE_ENV=development

# URL of the deployed/local frontend, used for CORS (see Fix 5)
FRONTEND_URL=http://localhost:3000
